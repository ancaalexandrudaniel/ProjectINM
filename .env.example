# =============================================================================
# INMAiMentor — Environment Variables
# =============================================================================
# Copy this file to .env and fill in the values.
#   cp .env.example .env
# =============================================================================

# --- Database (PostgreSQL) ---
# Full connection string including SSL params for Railway/Neon/Supabase
DATABASE_URL=postgresql://user:password@host:port/database

# --- Google Gemini AI ---
# API key from https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your-gemini-api-key

# (Optional) Override default model names
# GEMINI_MODEL=gemini-3-flash-preview
# GEMINI_EMBEDDING_MODEL=text-embedding-004

# --- Server ---
# PORT defaults to 5000 if not set
# PORT=5000

# NODE_ENV: "development" enables test/debug routes; "production" disables them
# NODE_ENV=development

# --- Object Storage (optional) ---
# Directory for private file storage (PDFs, uploads)
# PRIVATE_OBJECT_DIR=./private-objects
